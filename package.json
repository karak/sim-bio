{
  "name": "biotope-island",
  "version": "1.0.0",
  "description": "ブラウザで動く小さな島の生態系シミュレーション",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare": "VITE_LOG_URL=/api/v1/logs vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "npm run test -w worker",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && wrangler types worker/worker-configuration.d.ts --check",
    "types:worker": "wrangler types worker/worker-configuration.d.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:worker",
    "test:e2e": "playwright test",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev",
    "test:e2e:cloudflare": "npm run build:cloudflare && playwright test -c playwright.cloudflare.config.ts",
    "test:slow": "SLOW=1 vitest run",
    "bench:observe": "node tools/bench-observe.ts",
    "bench:observe:compare": "node tools/bench-observe-compare.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.141.0"
  },
  "private": true,
  "workspaces": [
    "worker"
  ]
}
